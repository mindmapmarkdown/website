---
import FourViz from './FourViz.astro';
import { T, GH } from '../i18n/content.js';
const { lang } = Astro.props;
const t = T[lang];

// Small mindmap used in the hero and the "two views" card.
const tree = `<svg viewBox="0 0 360 260" width="100%" height="100%" aria-hidden="true"><g fill="none" stroke="#E8603C" stroke-width="3">
<path d="M110 130 C150 130 150 70 190 70"/><path d="M110 130 C150 130 150 190 190 190"/>
<path d="M260 70 C285 70 285 40 300 40"/><path d="M260 70 C285 70 285 100 300 100"/><path d="M260 190 C285 190 285 160 300 160"/><path d="M260 190 C285 190 285 220 300 220"/></g>
<g font-family="Inter,Segoe UI,sans-serif" font-size="13" fill="#0F2A3F">
<rect x="14" y="112" width="100" height="36" rx="18" fill="#0F2A3F"/><text x="64" y="135" text-anchor="middle" fill="#fff" font-weight="700">Mindmap MD</text>
<rect x="186" y="54" width="78" height="32" rx="8" fill="#FFF5F1" stroke="#E8603C"/><text x="225" y="75" text-anchor="middle">Problem</text>
<rect x="186" y="174" width="78" height="32" rx="8" fill="#FFF5F1" stroke="#E8603C"/><text x="225" y="195" text-anchor="middle">Contract</text>
<circle cx="306" cy="40" r="6" fill="#2DD4BF"/><circle cx="306" cy="100" r="6" fill="#14B8A6"/><circle cx="306" cy="160" r="6" fill="#0D9488"/><circle cx="306" cy="220" r="6" fill="#0F766E"/>
<text x="318" y="44">Shallow</text><text x="318" y="104">Deep</text><text x="318" y="164">Lift</text><text x="318" y="224">Project</text></g></svg>`;
---
<section class="hero">
  <div class="wrap grid">
    <div>
      <span class="badge">{t.hero.badge}</span>
      <h1 set:html={t.hero.h1}></h1>
      <p class="sub" set:html={t.hero.sub}></p>
      <div class="cta">
        <a class="btn p" href={GH.specmd}>{t.hero.cta1} →</a>
        <a class="btn s" href={GH.org}>{t.hero.cta2}</a>
      </div>
    </div>
    <div class="viz" aria-hidden="true">
      <pre><span class="h"># Mindmap MD</span>
<span class="h">## Problem</span>
- Shallow
- Deep
<span class="h">## Contract</span>
- Lift
- Project</pre>
      <div class="arr"><div>→</div>{t.hero.lift}<div>←</div>{t.hero.projection}</div>
      <div class="tree"><Fragment set:html={tree} /></div>
    </div>
  </div>
</section>

<section id="why">
  <div class="wrap">
    <h2>{t.four.title}</h2>
    <p class="lead">{t.four.desc}</p>
    <FourViz f={t.four} />
  </div>
</section>

<section class="alt">
  <div class="wrap">
    <h2 set:html={t.loss.title}></h2>
    <p class="lead">{t.loss.desc}</p>
    <div class="lost">{t.loss.items.map((x) => <span>{x}</span>)}</div>
  </div>
</section>

<section id="viewer">
  <div class="wrap">
    <h2>{t.views.title}</h2>
    <p class="lead">{t.views.desc}</p>
    <div class="grid2 views">
      <div class="card"><div class="vbox"><Fragment set:html={tree.replace('width="100%" height="100%"', 'width="140" height="90"')} /></div><div><h3>{t.views.mindmap[0]}</h3><small>{t.views.mindmap[1]}</small><small>{t.views.mindmap[2]}</small></div></div>
      <div class="card"><div class="vbox"><svg width="120" height="80" viewBox="0 0 120 80" aria-hidden="true"><g stroke="#0F2A3F" stroke-width="5" stroke-linecap="round"><path d="M10 12h70"/><path d="M24 28h60"/><path d="M24 44h50"/><path d="M10 60h80"/><path d="M24 74h40"/></g></svg></div><div><h3>{t.views.outline[0]}</h3><small>{t.views.outline[1]}</small><small>{t.views.outline[2]}</small></div></div>
    </div>
  </div>
</section>

<section id="spec" class="alt">
  <div class="wrap">
    <h2>{t.levels.title}</h2>
    <p class="lead">{t.levels.desc}</p>
    <div class="grid3 lv">
      {t.levels.items.map((l, i) => (
        <div class="card"><span class={`tag t${i}`}>{l[0]}</span><b>{l[1]}</b><p>{l[2]}</p><div class="st">● {l[3]}</div></div>
      ))}
    </div>
    <p class="more"><a href={GH.specmd}>{t.levels.more} →</a></p>
  </div>
</section>

<section>
  <div class="wrap">
    <h2>{t.principles.title}</h2>
    <div class="grid4 pr">{t.principles.items.map((p) => <div class="card"><h3>{p[0]}</h3><p>{p[1]}</p></div>)}</div>
  </div>
</section>

<section id="implementations" class="alt">
  <div class="wrap">
    <h2>{t.repos.title}</h2>
    <div class="grid4 rp">
      {t.repos.items.map((r) => {
        const live = r[0] === 'spec' || r[0] === 'mindmapmd';
        const Tag = live ? 'a' : 'div';
        return <Tag class="card" href={live ? `${GH.org}/${r[0]}` : undefined}><h3><code>{r[0]}</code><span class={`pill ${live ? 'on' : ''}`}>{r[2]}</span></h3><p>{r[1]}</p></Tag>;
      })}
    </div>
  </div>
</section>

<section id="community">
  <div class="wrap">
    <div class="band">
      <div><h2>{t.join.title}</h2><p>{t.join.desc}</p></div>
      <div class="cta">
        <a class="btn p coral" href={GH.specmd}>{t.join.cta[0]}</a>
        <a class="btn s light" href={GH.discussions}>{t.join.cta[1]}</a>
        <a class="btn s light" href={GH.mindmapmd}>{t.join.cta[2]}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero { background: linear-gradient(180deg, #FFF7F3 0%, #fff 100%); padding: 80px 0 70px; }
  .grid { display: grid; grid-template-columns: 1.05fr 1fr; gap: 48px; align-items: center; }
  .badge { display: inline-block; background: #FEF3C7; color: #92400E; border-radius: 999px; padding: 6px 14px; font-size: 13px; font-weight: 600; margin-bottom: 20px; }
  h1 { font-size: 50px; line-height: 1.18; margin: 0 0 20px; letter-spacing: -1px; }
  .sub { font-size: 19px; line-height: 1.65; color: #36506A; margin: 0 0 30px; }
  .cta { display: flex; gap: 12px; flex-wrap: wrap; }
  .btn.p { background: #0F2A3F; color: #fff; }
  .btn.s { border: 1.5px solid #0F2A3F; color: #0F2A3F; }
  .btn.coral { background: #E8603C; }
  .btn.light { border-color: #FDBA9F; color: #FDE8E1; }
  .viz { background: #fff; border: 1px solid #DCE6EE; border-radius: 18px; box-shadow: 0 20px 50px rgba(15,42,63,.1); padding: 22px; display: grid; grid-template-columns: 1fr 50px 1.25fr; align-items: center; gap: 6px; }
  pre { margin: 0; background: #0F2A3F; color: #E2E8F0; border-radius: 12px; padding: 16px; font-size: 13px; line-height: 1.6; font-family: Consolas, Menlo, monospace; }
  pre .h { color: #5EEAD4; }
  .arr { display: flex; flex-direction: column; gap: 10px; align-items: center; font-size: 10px; color: #64748B; text-align: center; }
  .arr div { font-size: 22px; color: #E8603C; line-height: 1; }
  .tree { height: 220px; }
  section { padding: 72px 0; }
  section.alt { background: #F7FAFC; }
  h2 { font-size: 32px; line-height: 1.3; margin: 0 0 14px; letter-spacing: -.5px; }
  .lead { font-size: 17px; color: #475569; line-height: 1.7; max-width: 840px; margin: 0 0 34px; }
  .grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
  .grid3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
  .grid4 { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
  .card { background: #fff; border: 1px solid #E2E8F0; border-radius: 14px; padding: 22px; text-decoration: none; display: block; }
  a.card:hover { border-color: #E8603C; }
  .card h3 { margin: 0; font-size: 18px; }
  .card p { color: #475569; font-size: 15px; line-height: 1.6; margin: 10px 0 0; }
  .lost { display: flex; gap: 12px; flex-wrap: wrap; }
  .lost span { background: #FEE2E2; color: #991B1B; border-radius: 999px; padding: 9px 16px; font-size: 15px; text-decoration: line-through; text-decoration-color: #F87171; }
  .views .card { display: flex; gap: 18px; align-items: center; }
  .vbox { width: 150px; height: 96px; border-radius: 10px; background: #FFF7F3; border: 1px solid #FDD5C6; flex: none; display: flex; align-items: center; justify-content: center; }
  .views small { color: #64748B; display: block; margin-top: 6px; font-size: 14px; }
  .tag { display: inline-block; font-weight: 800; font-size: 20px; color: #fff; border-radius: 8px; padding: 3px 10px; margin-right: 8px; }
  .tag.t0 { background: #2DD4BF; color: #0F2A3F; } .tag.t1 { background: #0D9488; } .tag.t2 { background: #0F766E; }
  .lv .st { margin-top: 14px; font-size: 13px; font-weight: 600; color: #0F766E; }
  .more a { color: #E8603C; font-weight: 600; text-decoration: none; }
  .rp code { font-family: Consolas, Menlo, monospace; font-size: 16px; }
  .pill { float: right; font-size: 12px; border-radius: 999px; padding: 3px 10px; background: #E2E8F0; color: #334155; font-weight: 500; }
  .pill.on { background: #CCFBF1; color: #0F766E; }
  .band { background: #0F2A3F; color: #fff; border-radius: 20px; padding: 44px; display: flex; justify-content: space-between; align-items: center; gap: 30px; }
  .band h2 { color: #fff; } .band p { color: #CBD5E1; margin: 0; }
  @media (max-width: 900px) {
    .hero { padding: 44px 0; } .grid, .grid2, .grid3, .grid4 { grid-template-columns: 1fr; }
    h1 { font-size: 34px; } h2 { font-size: 25px; }
    .viz { grid-template-columns: 1fr; } .arr { flex-direction: row; justify-content: center; }
    .band { flex-direction: column; align-items: flex-start; padding: 28px; }
  }
</style>
