---
// Four properties: tiles on the left, a conceptual depth/readability chart on the right.
const { f } = Astro.props;
const xs = [0, 1, 2, 3, 4, 5].map((i) => 70 + i * 84);
const ys = { a: [52, 52, 52, 52, 52, 52], h: [58, 74, 118, 178, 222, 246], tr: [60, 64, 68, 72, 77, 82] };
const pl = (arr) => arr.map((y, i) => `${i ? 'L' : 'M'}${xs[i]} ${y}`).join(' ');
const area = `M${xs.map((x, i) => `${x} ${ys.tr[i]}`).join(' L')} L${[...xs].reverse().map((x, i) => `${x} ${ys.h[5 - i]}`).join(' L')} Z`;
const icons = [
  `<svg viewBox="0 0 48 48" width="40" height="40" fill="none" stroke="#0F2A3F" stroke-width="3" aria-hidden="true"><circle cx="24" cy="24" r="17"/><ellipse cx="24" cy="24" rx="7.5" ry="17"/><path d="M7 24h34M10 15h28M10 33h28"/></svg>`,
  `<svg viewBox="0 0 48 48" width="40" height="40" aria-hidden="true"><text x="24" y="33" text-anchor="middle" font-family="Consolas,monospace" font-weight="700" font-size="26" fill="#0F2A3F">{ }</text></svg>`,
  `<svg viewBox="0 0 48 48" width="40" height="40" fill="#0F2A3F" aria-hidden="true"><path d="M22 6 C23 17 27 21 38 22 C27 23 23 27 22 38 C21 27 17 23 6 22 C17 21 21 17 22 6Z"/><path d="M37 30 C37.5 34 39 35.5 43 36 C39 36.5 37.5 38 37 42 C36.5 38 35 36.5 31 36 C35 35.5 36.5 34 37 30Z"/></svg>`,
  `<svg viewBox="0 0 48 48" width="40" height="40" fill="none" stroke="#C2410C" stroke-width="3" aria-hidden="true"><path d="M4 24 C11 13 18 10 24 10 C30 10 37 13 44 24 C37 35 30 38 24 38 C18 38 11 35 4 24Z"/><circle cx="24" cy="24" r="7" fill="#C2410C"/></svg>`,
];
---
<div class="fv">
  <div class="tiles">
    {f.props.map((p, i) => (
      <div class={`pt ${i === 3 ? 'warn' : ''}`}>
        <Fragment set:html={icons[i]} />
        <div class="pn">{p[0]}</div>
        <div class="pd">{p[1]}</div>
        {i === 3
          ? <div class="sc"><span class="g">● {f.scale[0]}</span><span class="m">● {f.scale[1]}</span><span class="r">● {f.scale[2]}</span></div>
          : <div class="ok">{f.check}</div>}
      </div>
    ))}
  </div>
  <figure class="chartbox">
    <figcaption><b>{f.chartTitle}</b><span>{f.note}</span></figcaption>
    <svg viewBox="0 0 560 320" role="img" aria-label={f.chartTitle}>
      <rect width="560" height="320" rx="16" fill="#fff" />
      <path d={area} fill="#FDE8E1" opacity="0.9" />
      <g stroke="#E2E8F0">{[52, 112, 172, 232, 272].map((y) => <line x1="60" x2="510" y1={y} y2={y} />)}</g>
      <line x1="60" y1="280" x2="510" y2="280" stroke="#94A3B8" stroke-width="1.5" />
      <line x1="60" y1="30" x2="60" y2="280" stroke="#94A3B8" stroke-width="1.5" />
      {xs.map((x, i) => <text x={x} y="298" text-anchor="middle" font-size="12" fill="#64748B">{i + 1}</text>)}
      <text x="285" y="315" text-anchor="middle" font-size="12" fill="#475569">{f.axisX} →</text>
      <text x="22" y="160" font-size="12" fill="#475569" transform="rotate(-90 22 160)" text-anchor="middle">{f.axisY} →</text>
      <path d={pl(ys.a)} fill="none" stroke="#0F2A3F" stroke-width="4" stroke-linecap="round" />
      <path d={pl(ys.tr)} fill="none" stroke="#0D9488" stroke-width="4" stroke-dasharray="2 9" stroke-linecap="round" />
      <path d={pl(ys.h)} fill="none" stroke="#E8603C" stroke-width="4" stroke-linecap="round" />
      {xs.map((x, i) => <circle cx={x} cy={ys.h[i]} r="5" fill="#E8603C" />)}
      <text x="508" y="42" text-anchor="end" font-size="13" font-weight="700" fill="#0F2A3F">{f.l1}</text>
      <text x="508" y="100" text-anchor="end" font-size="13" font-weight="700" fill="#0D9488">{f.l3}</text>
      <text x="500" y="268" text-anchor="end" font-size="13" font-weight="700" fill="#C2410C">{f.l2}</text>
      <text x="420" y="145" text-anchor="middle" font-size="13" font-weight="700" fill="#9A3412">{f.gap}</text>
    </svg>
  </figure>
</div>

<style>
  .fv { display: grid; grid-template-columns: 1fr 1fr; gap: 28px; align-items: stretch; }
  .tiles { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  .pt { background: #fff; border: 1px solid #E2E8F0; border-radius: 16px; padding: 18px; }
  .pn { font-size: 18px; font-weight: 700; margin-top: 8px; }
  .pd { font-size: 13.5px; color: #64748B; margin-top: 4px; }
  .ok { margin-top: 12px; display: inline-block; font-size: 12.5px; font-weight: 700; color: #0F766E; background: #CCFBF1; border-radius: 999px; padding: 3px 10px; }
  .pt.warn { border: 2px solid #E8603C; background: #FFF5F1; }
  .sc { margin-top: 12px; display: flex; gap: 8px; font-size: 12px; font-weight: 700; flex-wrap: wrap; }
  .sc .g { color: #0F766E; } .sc .m { color: #D97706; } .sc .r { color: #B91C1C; }
  .chartbox { margin: 0; background: #F8FAFC; border: 1px solid #E2E8F0; border-radius: 16px; padding: 16px 16px 8px; }
  .chartbox figcaption { display: flex; justify-content: space-between; align-items: baseline; gap: 10px; margin: 2px 4px 8px; font-size: 16px; }
  .chartbox figcaption span { font-size: 11.5px; color: #94A3B8; white-space: nowrap; }
  .chartbox svg { width: 100%; height: auto; display: block; }
  @media (max-width: 900px) { .fv { grid-template-columns: 1fr; } }
</style>
