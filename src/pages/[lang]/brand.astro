---
import Base from '../../layouts/Base.astro';
import Brand from '../../components/Brand.astro';
import { T } from '../../i18n/content.js';
export function getStaticPaths() { return ['ko', 'ja', 'zh'].map((lang) => ({ params: { lang } })); }
const { lang } = Astro.params;
---
<Base lang={lang} page="brand" title={T[lang].meta.brandTitle} description={T[lang].brand.lead}><Brand lang={lang} /></Base>
